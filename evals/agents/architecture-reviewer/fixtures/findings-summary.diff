+"use client";
+
+import React from "react";
+import { useTranslations } from "next-intl";
+import { Badge } from "@devdigest/ui";
+import { usePrFindingsSummary } from "@/lib/hooks/reviews";
+import { s } from "./styles";
+
+interface FindingsSummaryBarProps {
+  prId: string | null | undefined;
+}
+
+export function FindingsSummaryBar({ prId }: FindingsSummaryBarProps) {
+  const t = useTranslations("prReview");
+  const { data } = usePrFindingsSummary(prId);
+  if (!data) return null;
+
+  const open = data.critical + data.warning + data.suggestion;
+  const isReady =
+    data.critical === 0 &&
+    data.warning <= 2 &&
+    (data.posted_comments === null || data.posted_comments >= data.critical + data.warning) &&
+    open < 10;
+
+  return (
+    <div style={s.bar} data-testid="findings-summary">
+      <span>
+        {t("overview.summary.counts", {
+          critical: data.critical,
+          warning: data.warning,
+          suggestion: data.suggestion,
+        })}
+      </span>
+      <Badge
+        color={isReady ? "var(--ok)" : "var(--crit)"}
+        bg={isReady ? "var(--ok-bg)" : "var(--crit-bg)"}
+      >
+        {isReady ? t("overview.summary.ready") : t("overview.summary.needsWork")}
+      </Badge>
+    </div>
+  );
+}
