+  async findingsSummary(workspaceId: string, prId: string): Promise<PrFindingsSummary> {
+    const pull = await this.repo.getPull(workspaceId, prId);
+    if (!pull) throw new NotFoundError('Pull request not found');
+    const repo = await this.repo.getRepo(pull.repoId);
+    if (!repo) throw new NotFoundError('Repo not found');
+
+    const summary: PrFindingsSummary = {
+      critical: 0,
+      warning: 0,
+      suggestion: 0,
+      dismissed: 0,
+      posted_comments: null,
+    };
+    for (const { findings } of await this.repo.reviewsForPull(prId)) {
+      for (const f of findings) {
+        if (f.dismissedAt) summary.dismissed += 1;
+        else if (f.severity === 'CRITICAL') summary.critical += 1;
+        else if (f.severity === 'WARNING') summary.warning += 1;
+        else summary.suggestion += 1;
+      }
+    }
+
+    try {
+      const github = await this.container.github();
+      const comments = await github.listReviewComments({ owner: repo.owner, name: repo.name }, pull.number);
+      summary.posted_comments = comments.length;
+    } catch {
+      summary.posted_comments = null;
+    }
+    return summary;
+  }
+
