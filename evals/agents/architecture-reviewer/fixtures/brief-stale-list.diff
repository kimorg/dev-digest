+  /** PRs of a repo whose brief was generated for an older head, newest PR first. */
+  async listStale(workspaceId: string, repoId: string, limit: number): Promise<StaleBriefItem[]> {
+    const rows = await this.deps.db
+      .select({ pull: t.pullRequests, json: t.prBrief.json })
+      .from(t.prBrief)
+      .innerJoin(t.pullRequests, eq(t.pullRequests.id, t.prBrief.prId))
+      .where(and(eq(t.pullRequests.workspaceId, workspaceId), eq(t.pullRequests.repoId, repoId)))
+      .orderBy(desc(t.pullRequests.number));
+
+    const items: StaleBriefItem[] = [];
+    for (const row of rows) {
+      const brief = toPrBriefRecord(row.json);
+      if (!brief || !isBriefStale(brief, row.pull.headSha)) continue;
+      items.push({
+        prId: row.pull.id,
+        number: row.pull.number,
+        title: taskLine(row.pull as PullRow),
+        generatedAt: brief.generated_at,
+        briefHeadSha: brief.head_sha,
+        currentHeadSha: row.pull.headSha,
+      });
+      if (items.length >= limit) break;
+    }
+    return items;
+  }
