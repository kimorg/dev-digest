+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { z } from 'zod';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+import { buildRiskBadgeService } from './wiring.js';
+
+const RiskBadgeDto = z.object({
+  prId: z.string().uuid(),
+  runId: z.string().uuid(),
+  level: z.enum(['green', 'amber', 'red']),
+  label: z.string(),
+  critical: z.number().int(),
+  warning: z.number().int(),
+  computedAt: z.string(),
+});
+
+/**
+ *   GET /pulls/:id/risk-badge → risk level of the PR's latest review run
+ */
+export default async function riskBadgeRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const service = buildRiskBadgeService(app.container);
+
+  app.get(
+    '/pulls/:id/risk-badge',
+    { schema: { params: IdParams, response: { 200: RiskBadgeDto } } },
+    async (req, reply) => {
+      const { workspaceId } = await getContext(app.container, req);
+      return service.get(workspaceId, req.params.id, reply);
+    },
+  );
+}
