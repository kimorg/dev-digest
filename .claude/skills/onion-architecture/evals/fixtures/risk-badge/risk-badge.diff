diff --git a/server/src/modules/risk-badge/repository.ts b/server/src/modules/risk-badge/repository.ts
new file mode 100644
index 0000000..d342013
--- /dev/null
+++ b/server/src/modules/risk-badge/repository.ts
@@ -0,0 +1,65 @@
+import { and, desc, eq, sql } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import * as t from '../../db/schema.js';
+import type { RiskBadgeStore } from './ports.js';
+import type { RiskLevel, RiskSnapshot } from './types.js';
+
+export class RiskBadgeRepository implements RiskBadgeStore {
+  constructor(private db: Db) {}
+
+  async computeAndSave(workspaceId: string, prId: string): Promise<RiskSnapshot | undefined> {
+    return this.db.transaction(async (tx) => {
+      const [run] = await tx
+        .select({ id: t.agentRuns.id })
+        .from(t.agentRuns)
+        .innerJoin(t.pullRequests, eq(t.pullRequests.id, t.agentRuns.prId))
+        .where(and(eq(t.pullRequests.workspaceId, workspaceId), eq(t.agentRuns.prId, prId)))
+        .orderBy(desc(t.agentRuns.createdAt))
+        .limit(1);
+      if (!run) return undefined;
+
+      const [agg] = await tx
+        .select({
+          critical: sql<number>`count(*) filter (where ${t.findings.severity} = 'CRITICAL')::int`,
+          warning: sql<number>`count(*) filter (where ${t.findings.severity} = 'WARNING')::int`,
+          level: sql<RiskLevel>`case
+            when count(*) filter (where ${t.findings.severity} = 'CRITICAL') > 0 then 'red'
+            when count(*) filter (where ${t.findings.severity} = 'WARNING') >= 3 then 'amber'
+            else 'green'
+          end`,
+        })
+        .from(t.findings)
+        .where(eq(t.findings.runId, run.id));
+
+      const [saved] = await tx
+        .insert(t.riskBadges)
+        .values({
+          prId,
+          runId: run.id,
+          level: agg?.level ?? 'green',
+          critical: agg?.critical ?? 0,
+          warning: agg?.warning ?? 0,
+        })
+        .onConflictDoUpdate({
+          target: t.riskBadges.prId,
+          set: {
+            runId: run.id,
+            level: agg?.level ?? 'green',
+            critical: agg?.critical ?? 0,
+            warning: agg?.warning ?? 0,
+            computedAt: sql`now()`,
+          },
+        })
+        .returning();
+
+      return {
+        prId: saved.prId,
+        runId: saved.runId,
+        level: saved.level as RiskLevel,
+        critical: saved.critical,
+        warning: saved.warning,
+        computedAt: saved.computedAt.toISOString(),
+      };
+    });
+  }
+}
