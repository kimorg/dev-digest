@@ -0,0 +1,17 @@
+import type { FastifyReply } from 'fastify';
+import { badgeLabel } from './domain.js';
+import type { RiskBadgeStore } from './ports.js';
+import type { RiskBadge } from './types.js';
+
+export class RiskBadgeService {
+  constructor(private store: RiskBadgeStore) {}
+
+  async get(workspaceId: string, prId: string, reply: FastifyReply): Promise<RiskBadge | undefined> {
+    const snapshot = await this.store.computeAndSave(workspaceId, prId);
+    if (!snapshot) {
+      reply.status(404).send({ error: { code: 'not_found', message: 'No review run for this pull request' } });
+      return undefined;
+    }
+    return { ...snapshot, label: badgeLabel(snapshot.level) };
+  }
+}
